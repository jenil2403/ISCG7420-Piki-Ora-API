{
  "info": {
    "name": "Piki Ora Medical Centre API",
    "description": "Run Login first. The test script saves the token, and the other requests send it as Authorization: Token {{token}}. Change base_url if the API is on Render.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health/"
          }
        },
        {
          "name": "Register patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sam\",\n  \"email\": \"sam@email.example\",\n  \"password\": \"Patient12345\",\n  \"first_name\": \"Sam\",\n  \"last_name\": \"Lee\",\n  \"phone\": \"021 555 0190\"\n}"
            },
            "url": "{{base_url}}/api/register/"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin12345\"\n}"
            },
            "url": "{{base_url}}/api/login/"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/me/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/logout/"
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "List doctors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/doctors/"
          }
        },
        {
          "name": "Add doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Alex Perry\",\n  \"specialty\": \"General Practitioner\",\n  \"email\": \"alex.perry@pikiora.example\",\n  \"phone\": \"09 555 0199\",\n  \"room\": \"Room 4\",\n  \"bio\": \"Morning clinics.\",\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/api/doctors/"
          }
        },
        {
          "name": "Update doctor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Hana Bennett\",\n  \"specialty\": \"General Practitioner\",\n  \"email\": \"hana.bennett@pikiora.example\",\n  \"phone\": \"09 555 0142\",\n  \"room\": \"Room 1\",\n  \"bio\": \"Everyday appointments and check-ups.\",\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/api/doctors/1/"
          }
        },
        {
          "name": "Remove doctor",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/doctors/4/"
          }
        }
      ]
    },
    {
      "name": "Slots",
      "item": [
        {
          "name": "Free times for a doctor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/slots/?doctor=1&available=true"
          }
        },
        {
          "name": "All times",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/slots/"
          }
        },
        {
          "name": "Add a time",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor\": 1,\n  \"date\": \"2026-12-02\",\n  \"start_time\": \"16:00\",\n  \"end_time\": \"16:20\"\n}"
            },
            "url": "{{base_url}}/api/slots/"
          }
        },
        {
          "name": "Remove a time",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/slots/2/"
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "List appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/appointments/"
          }
        },
        {
          "name": "Book appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot\": 2,\n  \"reason\": \"Sore throat\"\n}"
            },
            "url": "{{base_url}}/api/appointments/"
          }
        },
        {
          "name": "Change appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot\": 3,\n  \"reason\": \"Cough and sore throat\"\n}"
            },
            "url": "{{base_url}}/api/appointments/1/"
          }
        },
        {
          "name": "Cancel appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/appointments/1/cancel/"
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "List patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": "{{base_url}}/api/patients/"
          }
        },
        {
          "name": "Disable patient",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            },
            "url": "{{base_url}}/api/patients/2/"
          }
        }
      ]
    }
  ]
}
